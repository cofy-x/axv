{
  "dataDir": "/var/lib/axv",
  "socket": "/run/axv-host/control.sock",
  "socketGroup": 1000,
  "capacity": {
    "cpus": 32,
    "memoryMiB": 49152,
    "diskGiB": 800,
    "machines": 100,
    "workers": 4
  },
  "firecracker": {
    "binary": "/opt/axv/bin/firecracker",
    "jailer": "/opt/axv/bin/jailer",
    "version": "1.17.0",
    "cgroupParent": "system.slice/axv-host.service",
    "uid": 60000,
    "gid": 60000,
    "subnet": "172.30.0.0/22",
    "dns": "1.1.1.1"
  },
  "images": [
    {
      "id": "REPLACE_WITH_MANIFEST_ID",
      "name": "AXV Firecracker amd64",
      "provider": "firecracker",
      "arch": "amd64",
      "rootfs": "/opt/axv/images/REPLACE_WITH_GUEST_VERSION/root.ext4",
      "rootfsSHA256": "REPLACE_WITH_ACTUAL_SHA256",
      "kernel": "/opt/axv/kernels/vmlinux-6.1.155",
      "kernelSHA256": "REPLACE_WITH_ACTUAL_SHA256",
      "guest": {
        "imageVersion": 1,
        "protocolVersion": 3,
        "capabilities": [
          "exec",
          "terminals",
          "ssh",
          "network",
          "project-files",
          "project-tasks",
          "project-previews",
          "project-restore",
          "project-initialization"
        ],
        "binarySHA256": "REPLACE_WITH_MANIFEST_GUEST_BINARY_SHA256"
      }
    }
  ]
}
