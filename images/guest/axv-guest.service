[Unit]
Description=AXV guest execution service
Requires=axv-prepare.service
After=axv-prepare.service

[Service]
User=axv
Group=axv
WorkingDirectory=/projects
ExecStartPre=+/usr/local/lib/axv/prepare-tasks
ExecStart=/usr/local/bin/axv-guest --config /etc/axv/guest.json --listen vsock
Delegate=cpu memory pids
DelegateSubgroup=supervisor
TasksMax=4096
Restart=on-failure
RestartSec=2
KillMode=control-group

[Install]
WantedBy=multi-user.target
